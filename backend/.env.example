# Django Settings
SECRET_KEY=your-production-secret-key-change-this
DEBUG=True
ALLOWED_HOSTS=*

# Database (Leave empty for local SQLite; Provide on Render for PostgreSQL)
# Example: postgres://user:password@host:5432/dbname
DATABASE_URL=

# CORS and CSRF (Comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cloudinary Storage (Optional for local dev, Required for production images)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
